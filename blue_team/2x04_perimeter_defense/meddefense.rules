alert ip 10.10.4.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE LOCAL MEDDEV Traffic to Internet"; sid:9000001; rev:1; classtype:policy-violation;)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"MEDDEFENSE LOCAL Unauthorized SMB from Guest Network"; sid:9000002; rev:1; classtype:policy-violation;)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE LOCAL Large Outbound Transfer From Server"; flow:established,to_server; threshold:type threshold, track by_src, count 1, seconds 300; sid:9000003; rev:1; classtype:policy-violation;)
alert dns any any -> any any (msg:"MEDDEFENSE LOCAL DNS Tunneling Long Label"; dns.query; content:"."; distance:0; pcre:"/^[^.]{51,}/"; sid:9000004; rev:1; classtype:attempted-recon;)
alert tcp 10.10.2.0/24 any -> !10.10.1.10 3306 (msg:"MEDDEFENSE LOCAL Clinical Workstation to Unauthorized Database"; sid:9000005; rev:1; classtype:policy-violation;)
alert tcp any any -> 10.10.4.0/24 23 (msg:"MEDDEFENSE LOCAL Telnet Cleartext to Medical Device"; sid:9000006; rev:1; classtype:policy-violation;)
