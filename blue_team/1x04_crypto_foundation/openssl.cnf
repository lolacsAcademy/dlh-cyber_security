[ req ]
default_bits       = 256
prompt             = no
distinguished_name = req_dn
req_extensions     = req_ext

[ req_dn ]
C  = US
ST = California
L  = San Francisco
O  = MedDefense Health Systems
OU = Information Technology
CN = portal.meddefense.local

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
